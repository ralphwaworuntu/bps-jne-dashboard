# Salin ke .env dan sesuaikan. Jangan commit .env ke git publik.
JWT_SECRET_KEY=ganti-dengan-string-acak-panjang
# Lama token login (menit). Default 720 = 12 jam.
JWT_EXPIRE_MINUTES=720

# Fase 3 lokal — Postgres (Docker Compose)
# Host port 5433 agar tidak bentrok Postgres Windows di 5432.
# Kosongkan / hapus baris ini untuk fallback SQLite (darurat).
DATABASE_URL=postgresql+psycopg://bps:bps_local@127.0.0.1:5433/bps_jne

# Fase 3 lokal — Redis (antrian Celery + progress job)
REDIS_URL=redis://127.0.0.1:6379/0

# Job berat: 1 = pakai Celery+Redis; 0 = antrian in-process lama (tanpa Redis)
USE_CELERY=1

# Concurrency worker Celery (lokal disarankan 2)
CELERY_WORKER_CONCURRENCY=2
